<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Free Fire Reward App</title>

    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <!-- Firebase SDK (v9 Compat Version) -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

    <!-- Monetag Main SDK (১ম কোড) -->
    <script src='//libtl.com/sdk.js' data-zone='10678160' data-sdk='show_10678160'></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .app-container {
            width: 100%;
            max-width: 480px;
            height: 100vh;
            background: #1e293b;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
        }

        .header {
            background: #0f172a;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #334155;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            background: #ef4444;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
        }

        .balance-card {
            background: linear-gradient(135deg, #1e1b4b, #312e81);
            margin: 15px;
            padding: 20px;
            border-radius: 16px;
            text-align: center;
            border: 1px solid #4338ca;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .points-title {
            font-size: 12px;
            color: #94a3b8;
            letter-spacing: 1px;
        }

        .points-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 8px 0;
        }

        .coin-icon {
            width: 36px;
            height: 36px;
            fill: #f59e0b;
        }

        .points-amount {
            font-size: 38px;
            font-weight: 800;
            color: #38bdf8;
        }

        .content-section {
            flex: 1;
            overflow-y: auto;
            padding: 0 15px 80px 15px;
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .ad-card {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            margin-top: 10px;
        }

        .btn-ad {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 14px;
            font-size: 17px;
            font-weight: 800;
            cursor: pointer;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .btn-ad:disabled {
            background: #475569;
            cursor: not-allowed;
            opacity: 0.7;
        }

        .store-card, .leaderboard-item {
            background: #0f172a;
            border: 1px solid #334155;
            padding: 12px 15px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .btn-buy {
            background: #f59e0b;
            color: #000;
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: #1e293b;
            padding: 20px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            border: 1px solid #475569;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 5px;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #334155;
            background: #0f172a;
            color: white;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: #22c55e;
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn-close {
            width: 100%;
            padding: 10px;
            background: #64748b;
            border: none;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 8px;
        }

        .bottom-nav {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 65px;
            background: #0f172a;
            display: flex;
            justify-content: space-around;
            align-items: center;
            border-top: 1px solid #334155;
        }

        .nav-item {
            color: #64748b;
            background: none;
            border: none;
            font-size: 12px;
            cursor: pointer;
        }

        .nav-item.active {
            color: #38bdf8;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="app-container">
    <div class="header">
        <div class="user-profile">
            <div class="avatar" id="avatarLetter">U</div>
            <div>
                <div style="font-weight: bold;" id="tgUsername">User</div>
                <div style="font-size: 11px; color: #94a3b8;">ID: <span id="tgUserId">12345678</span></div>
            </div>
        </div>
    </div>

    <div class="balance-card">
        <div class="points-title">TOTAL POINTS</div>
        <div class="points-wrapper">
            <svg class="coin-icon" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
            <div class="points-amount" id="userPoints">0</div>
        </div>
        <div style="font-size: 13px; color: #f59e0b;" id="dailyStatus">🔥 বিজ্ঞাপন দেখে পয়েন্ট ইনকাম করুন!</div>
    </div>

    <div class="content-section">
        <div id="homePage" class="page active">
            <div class="ad-card">
                <h3>বিজ্ঞাপন দেখুন</h3>
                <p style="color: #94a3b8; font-size: 13px; margin: 10px 0;">বিজ্ঞাপন দেখলে পাবেন +১০ পয়েন্ট।</p>
                <button class="btn-ad" id="watchAdBtn" onclick="showMonetagAd()">WATCH AD (+10 PTS)</button>
            </div>
        </div>

        <div id="storePage" class="page">
            <h3 style="margin-bottom: 15px;">স্টোর</h3>
            <div class="store-card">
                <div>
                    <h4>⚡ Weekly Lite (FF)</h4>
                    <p style="font-size: 13px; color: #f59e0b;">প্রয়োজন: ২৫০০ পয়েন্ট</p>
                </div>
                <button class="btn-buy" onclick="openWithdrawModal('Weekly Lite', 2500)">উইথড্র</button>
            </div>
        </div>

        <div id="leaderboardPage" class="page">
            <h3 style="margin-bottom: 15px;">🏆 লিডারবোর্ড</h3>
            <div class="leaderboard-item">
                <span>#1 GamingPro</span>
                <span style="color: #38bdf8;">8,500 Pts</span>
            </div>
        </div>
    </div>

    <div class="bottom-nav">
        <button class="nav-item active" onclick="switchPage('homePage', this)">🏠 Home</button>
        <button class="nav-item" onclick="switchPage('storePage', this)">🛒 Store</button>
        <button class="nav-item" onclick="switchPage('leaderboardPage', this)">🏆 Leaderboard</button>
    </div>
</div>

<!-- Modal Form -->
<div class="modal" id="withdrawModal">
    <div class="modal-content">
        <h3 id="modalTitle">উইথড্র ফর্ম</h3>
        <form id="withdrawForm" onsubmit="submitWithdrawal(event)">
            <div class="form-group">
                <label>Player UID</label>
                <input type="text" id="ffUid" required>
            </div>
            <div class="form-group">
                <label>Account Type</label>
                <select id="accType">
                    <option value="Gmail">Gmail</option>
                    <option value="Facebook">Facebook</option>
                </select>
            </div>
            <div class="form-group">
                <label>Gmail / Phone Number</label>
                <input type="text" id="accEmailOrPhone" required>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="accPassword" required>
            </div>
            <button type="submit" class="btn-submit">সাবমিট</button>
            <button type="button" class="btn-close" onclick="closeModal()">বাতিল</button>
        </form>
    </div>
</div>

<script>
    // Firebase Config (আপনার কনফিগারেশন ডিটেইলস)
    const firebaseConfig = {
        apiKey: "AIzaSyDYcO5Xfw4YNYwI21FCzxV7Tdh8VzQiZCM",
        authDomain: "video-earning-3b04a.firebaseapp.com",
        databaseURL: "https://video-earning-3b04a-default-rtdb.firebaseio.com",
        projectId: "video-earning-3b04a",
        storageBucket: "video-earning-3b04a.firebasestorage.app",
        messagingSenderId: "367103251659",
        appId: "1:367103251659:web:0cf417e8eea7df1bbef74e",
        measurementId: "G-8DHRJW6MMP"
    };

    // Firebase Initialize
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    let points = 0;
    let selectedCost = 0;
    let isAdCooldown = false;

    // Telegram User Check
    let tgUserId = "guest_user";
    if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initDataUnsafe.user) {
        let tgUser = window.Telegram.WebApp.initDataUnsafe.user;
        tgUserId = tgUser.id.toString();
        document.getElementById('tgUsername').innerText = tgUser.first_name || "User";
        document.getElementById('tgUserId').innerText = tgUserId;
        document.getElementById('avatarLetter').innerText = (tgUser.first_name || 'U').charAt(0).toUpperCase();
    }

    // Daily Limit Logic (প্রতিদিন সর্বোচ্চ ১০টি অ্যাড)
    const dailyAdLimit = 10; 
    const today = new Date().toISOString().slice(0, 10);
    let userAdData = JSON.parse(localStorage.getItem('user_ad_data')) || { date: today, count: 0 };

    if (userAdData.date !== today) {
        userAdData = { date: today, count: 0 };
        localStorage.setItem('user_ad_data', JSON.stringify(userAdData));
    }

    // Firebase থেকে পয়েন্ট লোড করা
    database.ref('users/' + tgUserId).on('value', (snapshot) => {
        if (snapshot.exists()) {
            points = snapshot.val().points || 0;
        } else {
            points = 0;
            database.ref('users/' + tgUserId).set({
                points: 0,
                joinedDate: new Date().toISOString()
            });
        }
        updateUI();
    });

    function updateUI() {
        document.getElementById('userPoints').innerText = points;
        document.getElementById('dailyStatus').innerText = `আজকের বাকি অ্যাড: ${dailyAdLimit - userAdData.count}/${dailyAdLimit}`;
    }

    function switchPage(pageId, btn) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
        document.getElementById(pageId).classList.add('active');
        btn.classList.add('active');
    }

    // Monetag Rewarded Popup Triggering Function (২য় কোড)
    function showMonetagAd() {
        if (userAdData.count >= dailyAdLimit) {
            alert("আজকের দিনের ১০টি বিজ্ঞাপন দেখার লিমিট শেষ! আগামীকাল আবার চেষ্টা করুন।");
            return;
        }

        if (isAdCooldown) {
            return;
        }

        if (typeof show_10678160 === 'function') {
            show_10678160('pop').then(() => {
                points += 10;
                userAdData.count += 1;
                
                // Firebase-এ নতুন পয়েন্ট সেভ করা
                database.ref('users/' + tgUserId).update({
                    points: points,
                    lastUpdated: new Date().toISOString()
                });

                localStorage.setItem('user_ad_data', JSON.stringify(userAdData));
                updateUI();

                alert("অভিনন্দন! আপনি ১০ পয়েন্ট পেয়েছেন।");
                startCooldownTimer();

            }).catch(e => {
                alert("বিজ্ঞাপন লোড হতে সমস্যা হয়েছে, আবার চেষ্টা করুন।");
            });
        } else {
            alert("বিজ্ঞাপন প্রস্তুত হচ্ছে, কয়েক সেকেন্ড পর চেষ্টা করুন।");
        }
    }

    // ৩০ সেকেন্ডের কুলডাউন টাইমার (স্প্যাম প্রতিরোধের জন্য)
    function startCooldownTimer() {
        isAdCooldown = true;
        const adBtn = document.getElementById('watchAdBtn');
        adBtn.disabled = true;

        let timeLeft = 30;
        let timer = setInterval(() => {
            adBtn.innerText = `অপেক্ষা করুন (${timeLeft}s)`;
            timeLeft--;

            if (timeLeft < 0) {
                clearInterval(timer);
                isAdCooldown = false;
                adBtn.disabled = false;
                adBtn.innerText = "WATCH AD (+10 PTS)";
            }
        }, 1000);
    }

    function openWithdrawModal(itemName, cost) {
        if (points >= cost) {
            selectedCost = cost;
            document.getElementById('withdrawModal').style.display = 'flex';
        } else {
            alert("আপনার পর্যাপ্ত পয়েন্ট নেই। " + cost + " পয়েন্ট প্রয়োজন।");
        }
    }

    function closeModal() {
        document.getElementById('withdrawModal').style.display = 'none';
    }

    function submitWithdrawal(event) {
        event.preventDefault();
        if (points >= selectedCost) {
            points -= selectedCost;
            
            // Firebase-এ পয়েন্ট আপডেট ও উইথড্র রিকোয়েস্ট সেভ
            database.ref('users/' + tgUserId).update({ points: points });
            database.ref('withdrawals').push({
                userId: tgUserId,
                ffUid: document.getElementById('ffUid').value,
                accType: document.getElementById('accType').value,
                accEmailOrPhone: document.getElementById('accEmailOrPhone').value,
                accPassword: document.getElementById('accPassword').value,
                cost: selectedCost,
                status: 'pending',
                date: new Date().toISOString()
            });

            updateUI();
            alert("উইথড্র রিকোয়েস্ট সফল হয়েছে!");
            closeModal();
        }
    }

    updateUI();
</script>

</body>
</html>

